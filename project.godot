; Engine configuration file. Edit with care: there is no editor in this workflow.
config_version=5

[application]

config/name="Rolling Legends"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.043, 0.071, 0.137, 1)
boot_splash/show_image=false
config/icon="res://assets/icon.png"

[autoload]

Progress="*res://scripts/services/progress.gd"
Loc="*res://scripts/services/loc.gd"
Sound="*res://scripts/services/sound.gd"
Ads="*res://scripts/services/ads_service.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.043, 0.071, 0.137, 1)
